                             nParentIndexVarID = v;
                         else
@@ -12403,7 +12400,7 @@ CPLErr netCDFDataset::FilterVars(
                             CPLError(CE_Warning, CPLE_AppDefined,
                                      "Attribute instance_dimension='%s' refers "
                                      "to a non existing dimension",
-                                     szInstanceDimension);
+                                     osInstanceDimension.c_str());
                         else
