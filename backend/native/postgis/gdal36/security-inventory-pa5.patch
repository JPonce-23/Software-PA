+/* Private metadata-only inventory checks. No HDF error is reclassified after
+ * a failed fieldinfo/read call. ERROR is the default; UNAVAILABLE requires a
+ * positive proof that every active merged SDS has an explicit empty mapping. */
+intn
+EHfieldvalue(char *section[], const char *key, char *out, size_t capacity)
+{
+    const char *p;
+    size_t keylen;
+    int found = 0;
+    if (!out || !capacity) return -1;
+    out[0] = '\0';
+    if (!section || !section[0] || !section[1] || section[0] > section[1] || !key)
+        return -1;
+    keylen = strlen(key);
+    for (p = section[0]; p < section[1]; )
+    {
+        const char *end = (const char *)memchr(p, '\n', (size_t)(section[1] - p));
+        const char *start = p;
+        const char *value;
+        size_t length;
+        if (!end) return -1;
+        while (start < end && (*start == '\t' || *start == ' ')) start++;
+        if ((size_t)(end - start) > keylen && !memcmp(start, key, keylen) && start[keylen] == '=')
+        {
+            if (found) return -1;
+            value = start + keylen + 1;
+            while (value < end && (*value == ' ' || *value == '\t')) value++;
+            while (end > value && (end[-1] == '\r' || end[-1] == ' ' || end[-1] == '\t')) end--;
+            length = (size_t)(end - value);
+            if (length >= capacity) return -1;
+            memcpy(out, value, length); out[length] = '\0';
+            found = 1;
+        }
+        /* Do not use the trimmed value end to advance to the next line. */
+        p = (const char *)memchr(p, '\n', (size_t)(section[1] - p)) + 1;
+    }
+    return found ? 0 : -1;
+}
+
+/* Match whole field/OBJECT values, never substrings or global quote removal.
+ * Old ODL OBJECT="name" and new key=name / key="name" are both accepted.
+ * A found object is returned as a bounded interval ending at END_OBJECT. */
+intn
+EHfindfield(char *section[], const char *key, const char *name)
+{
+    const char *p;
+    char *begin = NULL, *matched_begin = NULL, *matched_end = NULL;
+    char object[UTLSTR_MAX_SIZE], close[UTLSTR_MAX_SIZE], value[UTLSTR_MAX_SIZE];
+    int matched = 0;
+    if (!section || !section[0] || !section[1] || section[0] > section[1] || !key || !name)
+        return -1;
+    for (p = section[0]; p < section[1]; )
+    {
+        const char *end = (const char *)memchr(p, '\n', (size_t)(section[1] - p));
+        const char *start = p;
+        if (!end) return -1;
+        while (start < end && (*start == '\t' || *start == ' ')) start++;
+        if ((size_t)(end-start) >= 7 && !memcmp(start, "OBJECT=", 7))
+        {
+            char *line[2] = {(char *)p, (char *)end + 1};
+            if (begin || EHfieldvalue(line, "OBJECT", object, sizeof(object)) < 0 || !object[0])
+                return -1;
+            begin = (char *)p;
+        }
+        else if ((size_t)(end-start) >= 11 && !memcmp(start, "END_OBJECT=", 11))
+        {
+            char *line[2] = {(char *)p, (char *)end + 1};
+            char *entry[2] = {begin, (char *)p};
+            size_t n;
+            if (!begin || EHfieldvalue(line, "END_OBJECT", close, sizeof(close)) < 0 || strcmp(object, close))
+                return -1;
+            if (object[0] == '"')
+            {
+                /* The quoted OBJECT value is the name in old ODL. */
+                memcpy(value, object, strlen(object) + 1);
+            }
+            else if (EHfieldvalue(entry, key, value, sizeof(value)) < 0)
+                return -1;
+            n = strlen(value);
+            if (n && value[0] == '"')
+            {
+                if (n < 2 || value[n-1] != '"') return -1;
+                memmove(value, value + 1, n - 2); value[n-2] = '\0';
+            }
+            if (!value[0]) return -1;
+            if (!strcmp(value, name))
+            {
+                if (matched) return -1;
+                matched = 1; matched_begin = begin; matched_end = (char *)p;
+            }
+            begin = NULL;
+        }
+        p = end + 1;
+    }
+    if (begin) return -1;
+    if (!matched) return 0;
+    section[0] = matched_begin; section[1] = matched_end;
+    return 1;
+}
+
+HDFEFieldInventoryStatus
+EHfieldinventory(int32 sdInterfaceID, const char *structure, const char *code,
+                 const char *group, const char *key, const char *field,
+                 int32 nSDS, const int32 *sdsIDs)
+{
+    char *buffer = NULL;
+    char *p[2];
+    char value[UTLSTR_MAX_SIZE], firstdim[UTLSTR_MAX_SIZE];
+    char *parts[8]; int32 lengths[8];
+    int32 rank, i, type;
+    HDFEFieldInventoryStatus result = HDFE_FIELD_ERROR;
+    int active = 0;
+    size_t len;
+    long firstsize;
+    char *tail;
+    buffer = EHmetagroup(sdInterfaceID, structure, code, group, p);
+    if (!buffer) return HDFE_FIELD_ERROR;
+    if (EHfindfield(p, key, field) != 1 ||
+        EHfieldvalue(p, "DataType", value, sizeof(value)) < 0 || (type = EHnumstr(value)) <= 0 ||
+        EHfieldvalue(p, "DimList", value, sizeof(value)) < 0)
+        goto done;
+    (void)type;
+    len = strlen(value);
+    if (len < 2 || value[0] != '(' || value[len-1] != ')') goto done;
+    memmove(value, value + 1, len - 2); value[len-2] = '\0';
+    rank = EHparsestr(value, ',', NULL, NULL);
+    /* The legacy fieldinfo implementation has eight local dimension slots. */
+    if (rank < 1 || rank > 8) goto done;
+    EHparsestr(value, ',', parts, lengths);
+    for (i = 0; i < rank; i++)
+        if (lengths[i] < 3 || lengths[i] > (int32)sizeof(firstdim) ||
+            parts[i][0] != '"' || parts[i][lengths[i]-1] != '"') goto done;
+    memcpy(firstdim, parts[0] + 1, (size_t)lengths[0] - 2);
+    firstdim[lengths[0]-2] = '\0';
+    if (rank == 1) { result = HDFE_FIELD_RETAIN; goto done; }
+    free(buffer); buffer = NULL;
+    /* Grid XDim/YDim are implicit. They do not require a Dimension object. */
+    if (!strcmp(code, "g") && (!strcmp(firstdim, "XDim") || !strcmp(firstdim, "YDim")))
+        return HDFE_FIELD_RETAIN;
+    buffer = EHmetagroup(sdInterfaceID, structure, code, "Dimension", p);
+    if (!buffer || EHfindfield(p, "DimensionName", firstdim) != 1 ||
+        EHfieldvalue(p, "Size", value, sizeof(value)) < 0 || !value[0]) goto done;
+    /* Parse a bounded nonnegative decimal without strtol overflow/locale. */
+    firstsize = 0;
+    for (tail = value; *tail; tail++)
+    {
+        if (*tail < '0' || *tail > '9' || firstsize > (INT_MAX - (*tail-'0'))/10) goto done;
+        firstsize = firstsize * 10 + (*tail-'0');
+    }
+    if (firstsize != 0) { result = HDFE_FIELD_RETAIN; goto done; }
+    free(buffer); buffer = NULL;
+    if (nSDS < 0 || (nSDS && !sdsIDs)) return HDFE_FIELD_ERROR;
+    if (!nSDS) return HDFE_FIELD_RETAIN; /* No proof of an empty merged mapping. */
+    for (i = 0; i < nSDS; i++)
+    {
+        char name[2048]; int32 sdsrank = 0, dims[H4_MAX_VAR_DIMS], nt = 0, attrs = 0, j;
+        if (!sdsIDs[i]) break; /* Same active-prefix convention as SDfldsrch. */
+        active++;
+        if (SDgetinfo(sdsIDs[i], name, &sdsrank, dims, &nt, &attrs) < 0 ||
+            sdsrank < 1 || sdsrank > H4_MAX_VAR_DIMS) goto done;
+        for (j = 0; j < sdsrank; j++) if (dims[j] < 0) goto done;
+        if (strncmp(name, "MRGFLD_", 7)) { result = HDFE_FIELD_RETAIN; goto done; }
+        buffer = EHmetagroup(sdInterfaceID, structure, code, "MergedFields", p);
+        if (!buffer || EHfindfield(p, "MergedFieldName", name) != 1 ||
+            EHfieldvalue(p, "FieldList", value, sizeof(value)) < 0) goto done;
+        /* Only an explicitly empty value is proof, never a failed lookup.
+         * A nonempty or unrecognised mapping keeps normal strict fieldinfo. */
+        if (value[0] && strcmp(value, "\"\""))
+        { result = HDFE_FIELD_RETAIN; goto done; }
+        free(buffer); buffer = NULL;
+    }
+    if (active) result = HDFE_FIELD_UNAVAILABLE;
+done:
+    free(buffer);
+    return result;
+}
