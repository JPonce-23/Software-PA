+
 server {
     listen 80;
     server_name _;
+    server_tokens off;
+    access_log /var/log/nginx/access.log ssalfer_safe;
+
+    # Keep these at server scope: a child add_header would replace inheritance
+    # on nginx 1.27. "always" also covers proxy/application error responses.
+    add_header X-Content-Type-Options "nosniff" always;
+    add_header Referrer-Policy "no-referrer" always;
+    add_header X-Frame-Options "SAMEORIGIN" always;
+    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
+    add_header Cache-Control "private, no-store" always;
+    # Candidate only: inline scripts and library behavior need browser QA.
