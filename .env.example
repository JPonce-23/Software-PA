# Copia este archivo como .env y reemplaza todos los valores change_me.
# El archivo .env está ignorado por Git y no debe confirmarse en el repositorio.

# PostgreSQL/PostGIS
DB_NAME=db_trenes
DB_USER=pa_app
DB_PASSWORD=change_me_database_password
DB_HOST_PORT=5433

# Backend
# Genera un valor con: openssl rand -hex 32
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
CORS_ORIGINS=http://localhost:5173
APP_ENV=development
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_INACTIVITY_MINUTES=30
AUTH_ABSOLUTE_MINUTES=480
AUTH_LOCK_MINUTES=15
# Sólo IPs exactas de proxies bajo control; vacío ignora X-Forwarded-For.
AUTH_TRUSTED_PROXY_IPS=
BACKEND_HOST_PORT=8000
UPLOAD_ROOT=/app/uploads
MAX_UPLOAD_BYTES=26214400

# Importador geoespacial seguro
IMPORT_MAX_FILE_SIZE_MB=100
IMPORT_STAGING_BATCH_SIZE=250
IMPORT_CONFIRM_BATCH_SIZE=100
IMPORT_GDAL_TIMEOUT_SECONDS=300
IMPORT_STAGING_RETENTION_DAYS=30
# Fraccion decimal entre 0 y 1. Vacio bloquea toda geometria reparada hasta
# que exista una tolerancia aprobada para el ambiente.
IMPORT_MAKE_VALID_MAX_AREA_DELTA=

# Bootstrap del primer administrador
# Valores no sensibles sugeridos para ejecutar backend/scripts/create_admin.py.
# La contraseña se captura por prompt interactivo o se pasa sólo como variable
# temporal ADMIN_PASSWORD en automatizaciones controladas.
ADMIN_EMAIL=change_me_admin_email
ADMIN_NOMBRE=change_me_admin_nombre
ADMIN_APELLIDO_PATERNO=change_me_admin_apellido
ADMIN_APELLIDO_MATERNO=

# Programador de alertas
ALERTAS_INTERVAL_SECONDS=86400
LOG_LEVEL=INFO

# Pruebas backend
# Deben corresponder a un administrador activo de una base aislada de pruebas.
# No reutilices credenciales productivas ni confirmes valores reales.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.local
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password
PGADMIN_HOST_PORT=5050

# Frontend
FRONTEND_HOST_PORT=5173

# Rotación de logs de Docker
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
